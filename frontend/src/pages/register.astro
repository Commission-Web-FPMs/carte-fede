---
import Layout from "@layouts/Layout.astro";
---

<Layout title="Inscription">
  <main
    class="min-h-[calc(100dvh-8rem)] bg-gradient-to-b from-slate-50 to-blue-50/40 px-4 py-8"
  >
    <section
      class="mx-auto max-w-lg rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8"
    >
      <p class="text-xs font-semibold uppercase tracking-widest text-blue-700">
        Carte Fédé
      </p>
      <h1 class="mt-2 text-2xl font-semibold text-blue-900">
        Demander la création d’un compte
      </h1>
      <p class="mt-2 text-sm text-slate-600">
        Votre compte sera disponible après validation par un administrateur. La
        demande reste valable 30 jours.
      </p>
      <form id="signupForm" class="mt-6 grid gap-4">
        <label class="block text-sm font-medium text-slate-700"
          >Nom
          <input
            name="nom"
            autocomplete="family-name"
            maxlength="100"
            required
            class="mt-2 min-h-11 w-full rounded-xl border border-slate-300 px-3 text-base focus-visible:outline-blue-600"
          />
        </label>
        <label class="block text-sm font-medium text-slate-700"
          >Prénom
          <input
            name="prenom"
            autocomplete="given-name"
            maxlength="100"
            required
            class="mt-2 min-h-11 w-full rounded-xl border border-slate-300 px-3 text-base focus-visible:outline-blue-600"
          />
        </label>
        <label class="flex min-h-11 items-center gap-3 text-sm font-medium text-slate-700">
          <input id="nonUmons" type="checkbox" class="size-5 accent-blue-900" />
          Inscription non-UMONS
        </label>
        <div id="umonsIdentifier">
          <label class="block text-sm font-medium text-slate-700"
            >Matricule UMONS (6 chiffres)
            <input
              name="member_id"
              inputmode="numeric"
              pattern="[0-9]{6}"
              minlength="6"
              maxlength="6"
              autocomplete="username"
              required
              class="mt-2 min-h-11 w-full rounded-xl border border-slate-300 px-3 text-base focus-visible:outline-blue-600"
            />
          </label>
        </div>
        <div id="emailIdentifier" hidden>
          <label class="block text-sm font-medium text-slate-700"
            >Adresse email
            <input
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              maxlength="254"
              disabled
              class="mt-2 min-h-11 w-full rounded-xl border border-slate-300 px-3 text-base focus-visible:outline-blue-600"
            />
          </label>
        </div>
        <label class="block text-sm font-medium text-slate-700"
          >Mot de passe (8 caractères minimum)
          <input
            name="password"
            type="password"
            minlength="8"
            maxlength="128"
            autocomplete="new-password"
            required
            class="mt-2 min-h-11 w-full rounded-xl border border-slate-300 px-3 text-base focus-visible:outline-blue-600"
          />
        </label>
        <label class="block text-sm font-medium text-slate-700"
          >Confirmer le mot de passe
          <input
            name="password2"
            type="password"
            minlength="8"
            maxlength="128"
            autocomplete="new-password"
            required
            class="mt-2 min-h-11 w-full rounded-xl border border-slate-300 px-3 text-base focus-visible:outline-blue-600"
          />
        </label>
        <button
          id="submitRegistration"
          class="min-h-11 rounded-xl bg-blue-900 px-4 py-2 font-semibold text-white hover:bg-blue-800 disabled:opacity-60"
          >Envoyer ma demande</button
        >
      </form>
      <p
        id="registrationMessage"
        role="status"
        aria-live="polite"
        class="mt-4 text-sm"
      >
      </p>
      <p class="mt-5 text-sm text-slate-600">
        Déjà inscrit ? <a
          href="/login"
          class="font-semibold text-blue-900 underline">Se connecter</a>
      </p>
    </section>
  </main>
</Layout>

<script>
  const nonUmons = document.getElementById("nonUmons") as HTMLInputElement | null;
  const memberGroup = document.getElementById("umonsIdentifier");
  const emailGroup = document.getElementById("emailIdentifier");
  const memberInput = document.querySelector<HTMLInputElement>('#signupForm [name="member_id"]');
  const emailInput = document.querySelector<HTMLInputElement>('#signupForm [name="email"]');
  function updateIdentifier() {
    if (!nonUmons || !memberGroup || !emailGroup || !memberInput || !emailInput) return;
    const useEmail = nonUmons.checked;
    memberGroup.hidden = useEmail;
    emailGroup.hidden = !useEmail;
    memberInput.disabled = useEmail;
    memberInput.required = !useEmail;
    emailInput.disabled = !useEmail;
    emailInput.required = useEmail;
  }
  nonUmons?.addEventListener("change", updateIdentifier);
  updateIdentifier();

  document
    .getElementById("signupForm")
    ?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(event.currentTarget instanceof HTMLFormElement)) return;
      const form = event.currentTarget;
      const message = document.getElementById("registrationMessage");
      const button = document.getElementById(
        "submitRegistration",
      ) as HTMLButtonElement | null;
      if (!message || !button) return;
      const values = Object.fromEntries(new FormData(form).entries());
      if (values.password !== values.password2) {
        message.textContent = "Les mots de passe ne correspondent pas.";
        message.className = "mt-4 text-sm text-red-700";
        return;
      }
      button.disabled = true;
      button.textContent = "Envoi…";
      message.textContent = "";
      try {
        const response = await fetch("/api/auth/register", {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(values),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok)
          throw new Error(
            response.status === 429
              ? "Trop de demandes. Réessayez dans quelques minutes."
              : result.error || "La demande n’a pas pu être envoyée.",
          );
        form.reset();
        form.style.display = "none";
        message.textContent =
          "Demande envoyée. Un administrateur doit la valider avant votre première connexion.";
        message.className =
          "mt-4 rounded-xl bg-emerald-50 p-3 text-sm text-emerald-800";
      } catch (error) {
        message.textContent =
          error instanceof Error
            ? error.message
            : "Connexion impossible. Réessayez.";
        message.className =
          "mt-4 rounded-xl bg-red-50 p-3 text-sm text-red-800";
        button.disabled = false;
        button.textContent = "Envoyer ma demande";
      }
    });
</script>
