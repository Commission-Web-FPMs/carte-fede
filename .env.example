# Copie locale pour docker-compose.yml. Les secrets de production restent dans Kubernetes.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/membres
# Renseigner une valeur aléatoire avant le lancement, par exemple avec openssl rand -hex 32.
SECRET_KEY=
# Activer uniquement pour initialiser une base vide, puis remettre à 0.
AUTO_CREATE_DB=0

# URL publique utilisée dans les emails de réinitialisation.
FRONTEND_BASE_URL=https://carte.fede.fpms.ac.be
REMEMBER_COOKIE_DAYS=30
PASSWORD_RESET_TOKEN_MAX_AGE=3600

MAIL_ADDRESS=
MAIL_PASSWORD=
MAIL_FROM_NAME=Commission Web FPMs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
